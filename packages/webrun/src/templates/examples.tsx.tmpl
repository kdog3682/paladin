import { Component, StrictMode, isValidElement, useEffect, useState } from "react"
import type { ReactNode } from "react"
import { createRoot } from "react-dom/client"
{{styles}}
import * as mod from {{entry}}
import source from {{source}}

const fns = mod as unknown as Record<string, unknown>

// namespace keys come back alphabetical; the file's own order is what the author
// wrote the examples in, so take that first and append anything the regex missed
// (`export const x = () => ...`)
const declared = [...String(source).matchAll(/^export\s+(?:async\s+)?function\s+(\w+)/gm)].map((m) => m[1]!)
const names = [...new Set([...declared, ...Object.keys(fns)])].filter(
  (name) => name !== "default" && typeof fns[name] === "function",
)

const hashName = () => decodeURIComponent(location.hash.slice(1))

class Boundary extends Component<{ children: ReactNode }, { error: Error | null }> {
  state = { error: null as Error | null }
  static getDerivedStateFromError(error: Error) {
    return { error }
  }
  render() {
    const { error } = this.state
    return error ? <pre style={{ color: "#b91c1c", whiteSpace: "pre-wrap", margin: 0 }}>{error.stack ?? String(error)}</pre> : this.props.children
  }
}

// the example is called *inside* a component so it can use hooks, and anything
// that isn't renderable (an object, an array of them) is shown as json
function Run({ name }: { name: string }) {
  const out = (fns[name] as () => unknown)()
  if (out == null || typeof out === "boolean" || typeof out === "string" || typeof out === "number" || isValidElement(out)) {
    return <>{out as ReactNode}</>
  }
  if (Array.isArray(out) && out.every((x) => isValidElement(x) || typeof x === "string" || typeof x === "number")) {
    return <>{out as ReactNode[]}</>
  }
  return <pre style={{ margin: 0 }}>{JSON.stringify(out, null, 2)}</pre>
}

function Example({ name }: { name: string }) {
  return (
    <section data-example={name} style={{ border: "1px solid #d4d4d8", borderRadius: 8, marginBottom: 16 }}>
      <header style={{ padding: "6px 12px", borderBottom: "1px solid #e4e4e7", fontFamily: "ui-monospace, monospace", fontSize: 13 }}>
        {name}
      </header>
      <div style={{ padding: 12 }}>
        <Boundary key={name}>
          <Run name={name} />
        </Boundary>
      </div>
    </section>
  )
}

function Gallery() {
  const [picked, setPicked] = useState(hashName)
  useEffect(() => {
    const sync = () => setPicked(hashName())
    addEventListener("hashchange", sync)
    return () => removeEventListener("hashchange", sync)
  }, [])

  // one example at a time: several mounted together would fight over global
  // listeners (hotkeys, focus). no valid #name falls back to the first.
  const current = names.includes(picked) ? picked : names[0]
  return (
    <main style={{ maxWidth: 960, margin: "0 auto", padding: 16, fontFamily: "system-ui, sans-serif" }}>
      <h1 style={{ fontSize: 14, fontFamily: "ui-monospace, monospace", margin: "0 0 8px" }}>
        {"{{title}}"} · {names.length} example{names.length === 1 ? "" : "s"}
      </h1>
      <p style={{ fontSize: 11, fontFamily: "ui-monospace, monospace", color: "#888", margin: "0 0 8px" }}>{"{{dir}}"}</p>
      <nav data-index style={{ display: "flex", flexWrap: "wrap", gap: 6, margin: "0 0 16px", fontFamily: "ui-monospace, monospace", fontSize: 12 }}>
        {names.map((name) => (
          <a
            key={name}
            href={"#" + encodeURIComponent(name)}
            aria-current={name === current ? "page" : undefined}
            style={{
              padding: "2px 8px",
              borderRadius: 999,
              border: "1px solid #d4d4d8",
              textDecoration: "none",
              color: name === current ? "#fff" : "inherit",
              background: name === current ? "#18181b" : "transparent",
            }}
          >
            {name}
          </a>
        ))}
      </nav>
      {names.length === 0 && <p>no exported functions in {"{{title}}"}</p>}
      {current && <Example key={current} name={current} />}
    </main>
  )
}

createRoot(document.getElementById("root")!).render(
  <StrictMode>
    <Gallery />
  </StrictMode>,
)
